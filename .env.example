# NEXT_PUBLIC_SITE_URL — The canonical URL of the site (optional for UI-only clone)
# NEXT_PUBLIC_SITE_URL=https://elevatex.in

# NEXT_PUBLIC_APP_URL — Backend API base URL (optional for UI-only clone)
# NEXT_PUBLIC_APP_URL=https://api.elevatex.in

# ─── Real integrations (uncomment when going to production) ───

# Auth (NextAuth.js)
# NEXTAUTH_SECRET=your-secret-here
# NEXTAUTH_URL=http://localhost:3000

# Database (Prisma + Postgres)
# DATABASE_URL=postgresql://user:pass@localhost:5432/elevatex

# Cloudinary (image/file uploads)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Email (Resend / SendGrid for registration confirmation)
# RESEND_API_KEY=re_xxxxxxxxxxxx
